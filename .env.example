# ---------------------------------------------------------------------------
# Ashe Agent Lab - example environment file
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored. NEVER commit real credentials to this repository.
# This file must only ever contain variable NAMES and placeholder values.
#
# Nothing here is required to run the framework's default example experiment:
# the built-in `echo` provider is offline and deterministic, so `make demo` and
# the test suite work with no credentials at all. You only need keys for the
# provider adapters you actually intend to call.
# ---------------------------------------------------------------------------

# --- OpenAI-compatible chat completions (provider: openai_chat) -------------
# Used by model entries with `provider: openai_chat`.
OPENAI_API_KEY=sk-replace-me
# Optional. Override to point at an OpenAI-compatible gateway
# (Azure OpenAI, OpenRouter, Together, a local llama.cpp server, vLLM, ...).
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic messages API (provider: anthropic_messages) ------------------
# Used by model entries with `provider: anthropic_messages`.
ANTHROPIC_API_KEY=sk-ant-replace-me
# Optional. Default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional. Default: 2023-06-01
# ANTHROPIC_API_VERSION=2023-06-01

# --- Framework behaviour (all optional) -------------------------------------
# Where run directories are written. Default: ./runs
# ASHE_LAB_RUNS_DIR=./runs
# Per-request HTTP timeout in seconds. Default: 120
# ASHE_LAB_HTTP_TIMEOUT=120
